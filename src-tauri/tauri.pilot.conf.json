{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Retranca OS Pilot",
  "mainBinaryName": "retranca-pilot",
  "identifier": "com.jornalistainclusivo.retranca.pilot",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Retranca Editorial OS — Piloto local",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
